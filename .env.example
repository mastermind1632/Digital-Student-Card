# Copy to .env (docker compose reads it). Every value is optional for local use.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studentcard
# APP_PORT=8080
# POSTGRES_PORT=5432

APP_INSTITUTION_NAME=Tshwane University of Technology
APP_INSTITUTION_SHORT_NAME=TUT
APP_CARD_OFFICE=the Student Card Office

# Address inside QR codes, e.g. http://192.168.1.20:8080 so phones on the same Wi-Fi can open the check page.
APP_PUBLIC_BASE_URL=
APP_CARD_VALIDITY_MONTHS=12
# false: self-registered cards are valid immediately (no approval step).
APP_REGISTRATION_APPROVAL=true
# If set, the "create the first administrator" page asks for this key.
APP_SETUP_KEY=

# Demo accounts and fictional students for presentations. Set to false for real use.
APP_DEMO_SEED=true

# Email for sending cards (optional). Gmail: smtp.gmail.com, 587, your address and a 16-character app password.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
